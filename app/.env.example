# AegisAgent on Arc — copy to .env and fill in. Never commit real keys.
# Frontend (public)
NEXT_PUBLIC_ARC_NETWORK=mainnet
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_FACTORY_ADDRESS=
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_TESTNET_FACTORY_ADDRESS=
# Scripts / agent (server only, keep secret)
ARC_NETWORK=mainnet
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_FACTORY_ADDRESS=
ARC_VAULT_ADDRESS=
ARC_DEPLOYER_ADDRESS=
ARC_DEPLOYER_PRIVATE_KEY=
ARC_OWNER_PRIVATE_KEY=
ARC_AGENT_PRIVATE_KEY=
ARC_PAYMENT_RECIPIENT=
ARC_PAYMENT_USDC=
ARC_PAYMENT_ID=
ARC_SMOKE_USDC=
# Keep empty until the human separately approves the exact mainnet operation.
ARC_MAINNET_CONFIRM=
# AI agent (optional): comma-separated Groq keys, rotated on rate limits
LLM_API_KEYS=
LLM_MODEL=
# Owner alerts (optional)
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hackathon primary AI provider: Meterless Nightshift (server only).
# Put NVIDIA credentials in Nightshift's Providers tab, not this project.
# Set URL + runtime token together. Empty URL keeps deterministic-only mode
# unless legacy LLM_API_KEYS / LLM_BASE_URL are configured above.
METERLESS_BASE_URL=
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
# Zetaris integration is still pending; these placeholders do not enable it.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=

# Hosted EarlyPay testnet API / UI (never use funded production keys here)
EARLYPAY_RELAYER_PRIVATE_KEY=
EARLYPAY_AGENT_PRIVATE_KEY=
EARLYPAY_VAULT=
NEXT_PUBLIC_EARLYPAY_VAULT=
NEXT_PUBLIC_EARLYPAY_AGENT=

# Judge-friendly local assessment (no chain transaction is sent)
SAMPLE_MODE=true
# For live mode, configure Nightshift above and set SAMPLE_MODE=false.
# You may use a Zetaris API key OR local username/password for token refresh.
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_DRIVER_CONTAINER=zetaris-driver-1
ZETARIS_DATA_PATH=/home/zetaris/customer-data/shared/aegis
# AEGIS_LOG_DIR and AEGIS_STATE_DIR are optional writable directories.
